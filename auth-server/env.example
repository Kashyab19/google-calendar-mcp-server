# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3080/oauth/google/callback

# Authorization Server Configuration
AUTH_SERVER_PORT=3080
AUTH_SERVER_ISSUER=http://localhost:3080
AUTH_SERVER_URL=http://localhost:3080

# MCP Server Configuration
# This should match the SMITHERY_RESOURCE_ID in the MCP server
# For local development: http://localhost:8081
# For Smithery playground: https://abc123.playground.smithery.ai
MCP_RESOURCE_ID=http://localhost:8081

# Security
JWT_ALGORITHM=RS256
ACCESS_TOKEN_LIFETIME=3600
REFRESH_TOKEN_LIFETIME=86400